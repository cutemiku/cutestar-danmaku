__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── Node / 前端 ──
node_modules/
dist/
*.tsbuildinfo

# ── .NET ──
bin/
obj/

# ── 工具链本地产物 ──
.mimocode/
.playwright-cli/

# ── 操作系统 ──
.DS_Store
