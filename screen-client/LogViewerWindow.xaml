<Window x:Class="Cutestar.Screen.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="星萌弹幕姬 大屏 - 运行状态与日志"
        Width="640" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="#1C2518" Foreground="#F4F6F0">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock x:Name="StatusText" Foreground="#9FB3A4" FontSize="13" VerticalAlignment="Center"/>
      <Button x:Name="RefreshBtn" Content="刷新" Width="64" Margin="12,0,0,0"
              Padding="4" Click="OnRefresh" Background="#3A4A3A" Foreground="#F4F6F0" BorderThickness="0"/>
    </StackPanel>
    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
             FontFamily="Consolas" FontSize="11"
             Background="#0E150C" Foreground="#C8D8C8" BorderThickness="0"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
  </DockPanel>
</Window>
