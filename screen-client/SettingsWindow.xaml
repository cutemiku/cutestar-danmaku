<Window x:Class="Cutestar.Screen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大屏设置" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1C2518" Foreground="#F4F6F0">
  <StackPanel Margin="28">
    <TextBlock Text="大屏配置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>

    <TextBlock Text="服务地址" Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <TextBox x:Name="ServerUrl" Padding="8,6" FontSize="14" Margin="0,0,0,14"/>

    <TextBlock Text="活动码（一般无需修改）" Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <TextBox x:Name="ActivityCode" Padding="8,6" FontSize="14"
             FontFamily="Consolas" CharacterCasing="Upper" Margin="0,0,0,14"/>

    <TextBlock Text="大屏密钥（管理面板申请）" Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <TextBox x:Name="ScreenKey" Padding="8,6" FontSize="14"
             FontFamily="Consolas" Margin="0,0,0,14"/>

    <TextBlock Text="活动名称（可单独修改，与活动码解耦）" Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <TextBox x:Name="ActivityName" Padding="8,6" FontSize="14" Margin="0,0,0,14"/>

    <CheckBox x:Name="UseServerSettings" Content="使用服务端统一下发的显示设置"
              IsChecked="True" Foreground="#F4F6F0" FontSize="13" Margin="0,0,0,4"
              Checked="OnServerSettingsToggled" Unchecked="OnServerSettingsToggled"/>
    <TextBlock x:Name="ServerSettingsHint" Foreground="#6D7D6E" FontSize="11"
               TextWrapping="Wrap" Margin="0,0,0,14"/>

    <TextBlock Text="目标显示器" Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <ComboBox x:Name="MonitorCombo" Padding="8,6" FontSize="14" Margin="0,0,0,14"/>

    <TextBlock Text="字体" Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <ComboBox x:Name="FontCombo" Padding="8,6" FontSize="14" IsEditable="True" Margin="0,0,0,14"/>

    <TextBlock Margin="0,0,0,4">
      <Run Text="弹幕速度"/>
      <Run x:Name="SpeedLabel" Foreground="#9FB3A4" FontSize="12"/>
    </TextBlock>
    <Slider x:Name="SpeedSlider" Minimum="40" Maximum="400"
            TickFrequency="20" IsSnapToTickEnabled="True"
            ValueChanged="OnSpeedChanged" Margin="0,0,0,14"/>

    <TextBlock Margin="0,0,0,4">
      <Run Text="字号"/>
      <Run x:Name="FontLabel" Foreground="#9FB3A4" FontSize="12"/>
    </TextBlock>
    <Slider x:Name="FontSlider" Minimum="16" Maximum="72"
            TickFrequency="2" IsSnapToTickEnabled="True"
            ValueChanged="OnFontChanged" Margin="0,0,0,14"/>

    <TextBlock Margin="0,0,0,4">
      <Run Text="不透明度"/>
      <Run x:Name="OpacityLabel" Foreground="#9FB3A4" FontSize="12"/>
    </TextBlock>
    <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0"
            TickFrequency="0.05" IsSnapToTickEnabled="True"
            ValueChanged="OnOpacityChanged" Margin="0,0,0,20"/>

    <Border Background="#243020" CornerRadius="6" Padding="14" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="测试弹幕" FontSize="13" Foreground="#9FB3A4" Margin="0,0,0,8"/>
        <TextBlock Text="不需要连接服务器，直接在大屏上预览弹幕效果。"
                   FontSize="11" Foreground="#6D7D6E" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TestContent" Grid.Column="0" Padding="8,6" FontSize="13"
                   Text="这条弹幕来自测试 ✦" VerticalContentAlignment="Center"/>
          <Button Grid.Column="1" Content="发送" Width="64" Padding="6" Margin="8,0,0,0"
                  Click="OnSendTest" Background="#E06B3C" Foreground="White"
                  BorderThickness="0" FontWeight="SemiBold" VerticalAlignment="Stretch"/>
        </Grid>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Width="80" Padding="6" Click="OnCancel"
              Background="#3A4A3A" Foreground="#F4F6F0" BorderThickness="0" Margin="0,0,12,0"/>
      <Button Content="保存" Width="80" Padding="6" Click="OnSave"
              Background="#E06B3C" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
    </StackPanel>
  </StackPanel>
</Window>
