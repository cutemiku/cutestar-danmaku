<Window x:Class="Cutestar.Screen.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大屏配置" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1C2518" Foreground="#F4F6F0">
  <StackPanel Margin="28">
    <TextBlock x:Name="TitleLabel" Text="首次配置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>

    <TextBlock x:Name="Message" Foreground="#E06B3C" FontSize="12" TextWrapping="Wrap"
               Visibility="Collapsed" Margin="0,0,0,12"/>

    <TextBlock Text="服务地址" Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <TextBox x:Name="ServerUrl" Padding="8,6" FontSize="14" Margin="0,0,0,14"/>

    <TextBlock Text="活动码" Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <TextBox x:Name="ActivityCode" Padding="8,6" FontSize="14"
             FontFamily="Consolas" CharacterCasing="Upper" Margin="0,0,0,14"/>

    <TextBlock Text="大屏密钥（管理面板申请，必填）" Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <TextBox x:Name="ScreenKey" Padding="8,6" FontSize="14"
             FontFamily="Consolas" Margin="0,0,0,14"/>

    <TextBlock Text="活动名称（可选，可单独修改，与活动码解耦）"
               Foreground="#9FB3A4" FontSize="12" Margin="0,0,0,4"/>
    <TextBox x:Name="ActivityName" Padding="8,6" FontSize="14" Margin="0,0,0,14"/>

    <CheckBox x:Name="UseServerSettings" Content="使用服务端统一下发的显示设置（字号、速度、不透明度、字体）"
              IsChecked="True" Foreground="#F4F6F0" FontSize="13" Margin="0,0,0,6"/>
    <TextBlock Text="开启后大屏显示参数由服务端下发；可稍后在设置中关闭并改用本地参数。"
               Foreground="#6D7D6E" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="退出" Width="80" Padding="6" Click="OnExit"
              Background="#3A4A3A" Foreground="#F4F6F0" BorderThickness="0" Margin="0,0,12,0"/>
      <Button Content="保存并连接" Width="100" Padding="6" Click="OnSave"
              Background="#E06B3C" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
    </StackPanel>
  </StackPanel>
</Window>
