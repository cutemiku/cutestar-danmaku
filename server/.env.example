# 复制为 server/.env 并按需修改；生产环境务必替换 JWT_SECRET 与 ADMIN_PASSWORD
CUTESTAR_ENV=development
CUTESTAR_DATABASE_URL=postgresql+asyncpg://cutestar:cutestar@localhost:5432/cutestar
# 留空则使用进程内事件总线（仅限单 worker）；多 worker 生产部署请填写
CUTESTAR_REDIS_URL=redis://localhost:6379/0
CUTESTAR_CORS_ORIGINS=https://danmaku.example.com
CUTESTAR_JWT_SECRET=please-generate-a-long-random-string
CUTESTAR_ADMIN_USERNAME=admin
CUTESTAR_ADMIN_PASSWORD=please-change-me
# Use a random 8-64 character URL-safe segment. The web build must use the same value.
CUTESTAR_ADMIN_ENTRY_PATH=replace-with-a-random-admin-entry

# 阿里云内容安全（自动审核功能）
# 开通服务: https://common-buy.aliyun.com/?commodityCode=lvwang_cip_public_cn
# 授权策略: AliyunYundunGreenWebFullAccess
CUTESTAR_ALIBABA_ACCESS_KEY_ID=
CUTESTAR_ALIBABA_ACCESS_KEY_SECRET=
CUTESTAR_ALIBABA_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
CUTESTAR_ALIBABA_GREEN_SERVICE=comment_detection
